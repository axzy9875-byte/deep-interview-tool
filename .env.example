# 公开部署时必须设置强密码；本机运行且未设置时，仅回环地址自动进入管理端。
ADMIN_PASSWORD=replace-with-a-long-admin-password
ADMIN_COOKIE_SECRET=replace-with-another-long-random-secret

HOST=0.0.0.0
PORT=5173
PUBLIC_ORIGIN=https://your-domain.example

# 公开部署必须把此目录挂载到持久化磁盘。
INTERVIEW_DATA_FILE=/data/public-interviews.json
PUBLIC_SPEECH_CONFIG_FILE=/data/public-speech.json

# 推荐在部署平台中保存公开语音密钥；设置后网页只显示状态，不能覆盖环境变量。
# 也可以留空，部署后由管理员在“公开访谈管理”中填写并保存到持久化磁盘。
PUBLIC_SPEECH_ENABLED=true
PUBLIC_SPEECH_API_KEY=
PUBLIC_SPEECH_MODEL=doubao-seed-2-0-lite-260428
